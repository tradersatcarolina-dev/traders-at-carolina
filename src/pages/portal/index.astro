---
import PortalLayout from '../../layouts/PortalLayout.astro';
import QuestionRow from '../../components/members/QuestionRow.astro';
import {
  weekdayShort, dayOfMonth, timeOfDay, longDate, sessionLabel, sessionMaterials,
  type Question, type Resource, type Session,
} from '../../lib/portal';

export const prerender = false;

const { supabase, profile, user } = Astro.locals;
const now = new Date().toISOString();

const [nextRes, toolsRes, questionsRes, slidesRes] = await Promise.all([
  supabase.from('sessions').select('*').gte('date', now).order('date').limit(1).maybeSingle(),
  supabase.from('resources').select('*').eq('category', 'Practice tools').order('sort_order').order('title').limit(8),
  supabase.from('question_feed').select('*').order('created_at', { ascending: false }).limit(4),
  supabase.from('sessions').select('*').lt('date', now).order('date', { ascending: false }).limit(3),
]);

const nextSession = nextRes.data as Session | null;
const tools = (toolsRes.data ?? []) as Resource[];
const questions = (questionsRes.data ?? []) as Question[];
const latest = (slidesRes.data ?? []) as Session[];

const firstName = profile.full_name?.trim().split(/\s+/)[0] || user?.email?.split('@')[0] || 'there';
---

<PortalLayout title="Home">
  <div class="welcome">
    <h1 class="page-title serif">Welcome back, {firstName}</h1>
    {nextSession && (
      <div class="next box">
        <div class="next__date">
          <p class="next__dow">{weekdayShort(nextSession.date)}</p>
          <p class="next__day serif">{dayOfMonth(nextSession.date)}</p>
        </div>
        <div>
          <p class="next__title">Next session: {nextSession.title}</p>
          <p class="next__where">
            {longDate(nextSession.date)} · {timeOfDay(nextSession.date)}{nextSession.location && ` · ${nextSession.location}`}
          </p>
        </div>
      </div>
    )}
  </div>

  <section class="section" aria-labelledby="tools-h">
    <div class="section__head">
      <h2 class="h2" id="tools-h">Practice tools</h2>
      <a href="/portal/resources">All resources</a>
    </div>
    {tools.length > 0 ? (
      <div class="tools">
        {tools.map((t) => (
          <a class="tool box" href={t.url} target="_blank" rel="noopener noreferrer">
            <span class="tool__title">{t.title} <span aria-hidden="true">↗</span><span class="visually-hidden"> (opens in a new tab)</span></span>
            {t.description && <span class="tool__desc">{t.description}</span>}
          </a>
        ))}
      </div>
    ) : (
      <p class="box empty">No practice tools yet.</p>
    )}
  </section>

  <div class="cols">
    <section class="section cols__main" aria-labelledby="new-h">
      <div class="section__head">
        <h2 class="h2" id="new-h">New in the problem bank</h2>
        <a class="btn btn--small" href="/portal/problem-bank#submit">Submit a question</a>
      </div>
      <div class="box">
        {questions.length > 0
          ? questions.map((q) => <QuestionRow question={q} href={`/portal/problem-bank?open=${q.id}`} />)
          : <p class="empty">No questions yet. Be the first to add one.</p>}
      </div>
    </section>

    <aside class="section cols__side" aria-labelledby="slides-h">
      <div class="section__head">
        <h2 class="h2" id="slides-h">Latest slides</h2>
      </div>
      <div class="box">
        {latest.length > 0
          ? latest.map((s) => (
              <a class="row-link" href={s.slides_url ?? s.recording_url ?? '/portal/slides'} {...(s.slides_url || s.recording_url ? { target: '_blank', rel: 'noopener noreferrer' } : {})}>
                <span class="slide__title">{sessionLabel(s)}</span>
                <span class="slide__meta">{sessionMaterials(s)}</span>
              </a>
            ))
          : <p class="empty">Slides will appear here after each session.</p>}
      </div>
      <a href="/portal/slides">All sessions</a>
    </aside>
  </div>
</PortalLayout>

<style>
  .welcome { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 24px; }
  .next { padding: 12px 16px; display: flex; gap: 14px; align-items: center; }
  .next__date { text-align: center; padding-right: 14px; border-right: 1px solid var(--rule); }
  .next__dow { font-size: 11.5px; text-transform: uppercase; letter-spacing: 0.08em; color: var(--muted); }
  .next__day { font-size: 26px; line-height: 1; }
  .next__title { margin-bottom: 2px; font-weight: 600; font-size: 14.5px; }
  .next__where { font-size: 13px; color: var(--secondary); }

  .tools { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 12px; }
  .tool { padding: 16px 18px; text-decoration: none; color: var(--ink); display: flex; flex-direction: column; gap: 4px; min-height: 88px; }
  .tool:hover { color: var(--ink); }
  .tool__title { font-weight: 600; font-size: 15px; }
  .tool__desc { font-size: 13px; color: var(--secondary); }

  .cols { display: flex; flex-wrap: wrap; gap: 28px; }
  .cols__main { flex: 999 1 560px; min-width: 0; }
  .cols__side { flex: 1 1 320px; min-width: 0; }
  .cols__side > a { font-size: 14px; align-self: flex-start; }
  .slide__title { display: block; font-weight: 500; font-size: 14.5px; }
  .slide__meta { font-size: 13px; color: var(--muted); }

  @media (max-width: 640px) {
    .next { width: 100%; }
  }
</style>
