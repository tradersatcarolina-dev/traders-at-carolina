---
import AuthLayout from '../layouts/AuthLayout.astro';
import site from '../data/site.json';
import { REMEMBER_COOKIE, safeNext } from '../lib/supabase';

export const prerender = false;

const ERRORS: Record<string, string> = {
  'not-member': "This email isn't on the member list. Ask a club president to add you.",
  'link-expired': 'That link has expired or was already used.',
  'other-browser': 'That link didn’t work. Open it in the same browser you asked for it from.',
};

const next = safeNext(Astro.url.searchParams.get('next'));
let error = ERRORS[Astro.url.searchParams.get('error') ?? ''] ?? '';
let email = '';
let remember = true;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  email = String(form.get('email') ?? '').trim();
  remember = form.get('remember') === 'on';

  // Remember the choice before Supabase writes any session cookies.
  Astro.cookies.set(REMEMBER_COOKIE, remember ? '1' : '0', {
    path: '/', sameSite: 'lax', httpOnly: true, secure: import.meta.env.PROD,
    ...(remember ? { maxAge: 60 * 60 * 24 * 400 } : {}),
  });

  if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
    error = 'Enter the email address a club president set up for you.';
  } else {
    const password = String(form.get('password') ?? '');
    const { error: err } = await Astro.locals.supabase.auth.signInWithPassword({ email, password });
    if (!err) return Astro.redirect(next);
    error = err.code === 'email_not_confirmed'
      ? 'Finish setting up your account first using the link in your invite email.'
      : 'That email and password don’t match. Try again, or reset your password.';
  }
}
---

<AuthLayout title="Log in">
  <form class="auth__form" method="post" novalidate>
    <div>
      <h1 class="auth__title serif">Log in</h1>
      <p class="auth__lede">Welcome back.</p>
    </div>

    {error && <p class="alert alert--error" role="alert">{error}</p>}

    <div class="field">
      <label for="email">Email</label>
      <input class="input" id="email" name="email" type="email" autocomplete="username" placeholder="you@example.com" value={email} aria-describedby="email-hint" />
      <p class="hint" id="email-hint">Use the email a club president set up for you. Personal email recommended so it works after you graduate.</p>
    </div>
    <div class="field">
      <div class="field__row">
        <label for="password">Password</label>
        <a class="auth__small-link" href="/forgot-password">Forgot password?</a>
      </div>
      <input class="input" id="password" name="password" type="password" autocomplete="current-password" />
    </div>
    <label class="check"><input type="checkbox" name="remember" checked={remember} /> Keep me signed in</label>
    <button class="btn btn--block" type="submit">Log in</button>

    <div class="auth__footer">
      <p>
        Not a member yet?{' '}
        <a href={site.googleFormUrl} target="_blank" rel="noopener noreferrer">Fill out our interest form <span aria-hidden="true">↗</span><span class="visually-hidden"> (opens in a new tab)</span></a>
      </p>
    </div>
  </form>
</AuthLayout>
