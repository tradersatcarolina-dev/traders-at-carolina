---
import AuthLayout from '../layouts/AuthLayout.astro';

export const prerender = false;

const linkError = Astro.url.searchParams.get('error');
let email = '';
let error = '';
let sent = false;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  email = String(form.get('email') ?? '').trim();
  if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
    error = 'Enter the email you log in with.';
  } else {
    // The email links to /auth/confirm (directly with our template, or via
    // Supabase with the default one), which signs the member in for this one
    // purpose and sends them to /reset-password.
    await Astro.locals.supabase.auth.resetPasswordForEmail(email, {
      redirectTo: new URL('/auth/confirm?next=/reset-password', Astro.url.origin).href,
    });
    sent = true;
  }
}
---

<AuthLayout title="Forgot password">
  <div>
    <h1 class="auth__title serif">Forgot password</h1>
    <p class="auth__lede">We'll email you a link to choose a new one.</p>
  </div>

  {linkError === 'link-expired' && <p class="alert alert--error" role="alert">That reset link has expired or was already used. Request a new one below.</p>}
  {linkError === 'other-browser' && <p class="alert alert--error" role="alert">That reset link didn’t work. Open it in the same browser you asked for it from, or request a new one below.</p>}

  {sent ? (
    <p class="alert alert--ok" role="status">If {email} has an account, a reset link is on its way. It works once and expires soon.</p>
  ) : (
    <form class="auth__form" method="post" novalidate>
      {error && <p class="alert alert--error" role="alert">{error}</p>}
      <div class="field">
        <label for="email">Email</label>
        <input class="input" id="email" name="email" type="email" autocomplete="username" placeholder="you@example.com" value={email} />
      </div>
      <button class="btn btn--block" type="submit">Email me a reset link</button>
    </form>
  )}

  <div class="auth__footer">
    <p>Remembered it? <a href="/login">Back to log in</a></p>
  </div>
</AuthLayout>
