---
import AuthLayout from '../layouts/AuthLayout.astro';

export const prerender = false;

// Reached from the reset email via /auth/confirm, which signs the member in.
const { supabase, user } = Astro.locals;
let error = '';

if (user && Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const password = String(form.get('password') ?? '');
  const confirm = String(form.get('confirm') ?? '');
  if (password.length < 8) error = 'Choose a password with at least 8 characters.';
  else if (password !== confirm) error = "The two passwords don't match.";
  else {
    const { error: err } = await supabase.auth.updateUser({ password });
    if (!err) return Astro.redirect('/portal');
    error = err.code === 'same_password' ? 'Choose a password that’s different from your old one.'
      : err.code === 'weak_password' ? 'That password is too weak. Try a longer one.'
      : "We couldn't save your password. Please try again.";
  }
}
---

<AuthLayout title="Choose a new password">
  <div>
    <h1 class="auth__title serif">New password</h1>
    {user && <p class="auth__lede">For {user.email}.</p>}
  </div>

  {user ? (
    <form class="auth__form" method="post">
      {error && <p class="alert alert--error" role="alert">{error}</p>}
      <div class="field">
        <label for="password">New password</label>
        <input class="input" id="password" name="password" type="password" autocomplete="new-password" minlength="8" required aria-describedby="pw-hint" />
        <p class="hint" id="pw-hint">At least 8 characters.</p>
      </div>
      <div class="field">
        <label for="confirm">Confirm new password</label>
        <input class="input" id="confirm" name="confirm" type="password" autocomplete="new-password" minlength="8" required />
      </div>
      <button class="btn btn--block" type="submit">Save password</button>
    </form>
  ) : (
    <p>Open the reset link from your email to choose a new password. <a href="/forgot-password">Need a new link?</a></p>
  )}

  <div class="auth__footer">
    <p><a href="/login">Back to log in</a></p>
  </div>
</AuthLayout>
