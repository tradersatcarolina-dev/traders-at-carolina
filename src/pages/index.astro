---
import Base from '../layouts/Base.astro';
import Gallery from '../components/Gallery.astro';
import RailSection from '../components/RailSection.astro';
import site from '../data/site.json';

const { stats } = site;

const programRows = [
  {
    title: 'Weekly Sessions',
    photo: '/images/gallery/interest-meeting-1.jpg',
    alt: 'Students with laptops and notebooks following along in a lecture hall',
    body: `Members work through a structured curriculum that starts from first principles: probability and expected value, then betting and market making, then options intuition and the mental math interviewers expect. Each session pairs a short lesson with problems you solve in small groups, so you leave with practice, not just notes. Members also take on quantitative research projects in areas like derivatives, prediction markets and commodities, and publish their work at the end of each semester.`,
  },
  {
    title: 'Games & Firm Events',
    photo: '/images/programs/poker.jpg',
    alt: 'Members holding prizes next to a table of poker chips',
    body: `Some of the best practice happens away from the whiteboard. We play poker and trading games with partner firms, host networking nights where members meet traders and recruiters directly, and bring firms like Jane Street to campus for information sessions. Members also get exclusive access to our recruitment materials to prepare for applications and interviews.`,
  },
];

const steps = [
  { title: 'Coffee chats & info session', body: 'Meet current members one on one, then come to our info session to hear what a semester with the club looks like and ask anything.' },
  { title: 'Written application', body: 'A short application with a few questions about why you are interested and a handful of probability and logic problems. No finance knowledge expected.' },
  { title: 'Interview', body: 'A conversation with two board members: some questions about you, and a problem or two worked through together out loud.' },
  { title: 'Final results', body: 'Everyone who applies hears back by email. New members are welcomed at our first session of the semester.' },
];
---

<Base title="Traders at Carolina">
  <Gallery layout="mosaic" class="hero" label="Introduction" zoom>
    <div class="container hero__content">
      <h1 class="hero__title">Traders at Carolina</h1>
      <p class="hero__sub">UNC's quantitative finance club.</p>
      <div class="hero__actions">
        <a class="btn btn--white-blue" href="#recruiting">Recruiting timeline</a>
        <a class="btn btn--outline-white" href={site.googleFormUrl} target="_blank" rel="noopener noreferrer">
          Join us<span class="visually-hidden"> (opens in a new tab)</span>
        </a>
      </div>
    </div>
  </Gallery>

  <RailSection number="01" label="About" id="about">
    <h2 class="h-section about__title">A home for quantitative thinkers at UNC.</h2>
    <div class="about__copy">
      <p>Most students hear about quantitative trading long after they could have started preparing for it. Traders at Carolina exists to close that gap. We're a student-run community of mathematicians, computer scientists, economists and the merely curious, and we meet every week to work through the probability, market intuition and problem solving that trading and research roles demand.</p>
      <p>You don't need a finance background to join. Our members come from every major, and most of them learned what a bid and an ask were here. What they share is an appetite for hard problems and a willingness to think out loud with others.</p>
    </div>
    <dl class="stats">
      <div><dt class="mono">Semesters running</dt><dd>{stats.semesters}</dd></div>
      <div><dt class="mono">Members · Tight-knit community</dt><dd>{stats.members}</dd></div>
    </dl>
  </RailSection>

  <RailSection number="02" label="Programs" id="programs" wash>
    <h2 class="visually-hidden">Programs</h2>
    <div class="programs">
      {programRows.map((p, i) => (
        <article class:list={['program', { 'program--flip': i % 2 === 1 }]}>
          <div class="program__photo">
            <img src={p.photo} alt={p.alt} width="1200" height="900" loading="lazy" decoding="async" />
          </div>
          <div class="program__text">
            <h3>{p.title}</h3>
            <p>{p.body}</p>
          </div>
        </article>
      ))}
    </div>
  </RailSection>

  <RailSection number="03" label="Recruiting" id="recruiting">
    <h2 class="h-section">Recruiting timeline</h2>
    <p class="recruit__intro">
      {site.recruitingStatus.open
        ? `We take new members each ${site.recruitingCycles}. Here's how the process works, start to finish.`
        : site.recruitingStatus.message}
    </p>
    <ol class="timeline">
      {steps.map((s, i) => (
        <li class="step">
          <span class="step__num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          <h3>{s.title}</h3>
          <p>{s.body}</p>
        </li>
      ))}
    </ol>
  </RailSection>

  <section class="band on-dark">
    <div class="container">
      <h2>Traders at Carolina</h2>
      <a class="btn btn--white" href={site.googleFormUrl} target="_blank" rel="noopener noreferrer">
        Join us<span class="visually-hidden"> (opens in a new tab)</span>
      </a>
    </div>
  </section>
</Base>

<style>
  /* Hero */
  :global(.hero) {
    min-height: 600px;
    display: flex;
    align-items: center;
  }
  :global(.hero .gallery__content) { width: 100%; }
  .hero__content {
    text-align: center;
    padding-top: 88px;
    padding-bottom: 88px;
  }
  .hero__title {
    font-size: clamp(46px, 6.4vw, 88px);
    line-height: 1;
  }
  .hero__sub {
    margin-top: 14px;
    font-size: 20px;
    line-height: 1.4;
    color: var(--white);
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    margin-top: 32px;
  }
  @media (max-width: 600px) {
    :global(.hero) { min-height: 520px; }
    .hero__sub { font-size: 18px; }
    .hero__actions .btn { width: 100%; }
  }

  /* About */
  .about__title { max-width: 16ch; }
  .about__copy {
    display: grid;
    gap: 16px;
    max-width: 66ch;
    margin-top: 26px;
  }
  .stats {
    display: grid;
    grid-template-columns: repeat(2, max-content);
    gap: 24px 96px;
    margin: 44px 0 0;
    padding-top: 26px;
    border-top: 1px solid var(--rule);
  }
  .stats div { display: flex; flex-direction: column-reverse; justify-content: flex-end; gap: 8px; }
  .stats dd {
    margin: 0;
    font-family: var(--serif);
    font-size: clamp(42px, 4.6vw, 60px);
    line-height: 1;
    color: var(--ink);
  }
  .stats dt { color: var(--muted); }
  @media (max-width: 600px) {
    .stats { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 20px 24px; }
  }

  /* Programs */
  .programs { display: grid; gap: 60px; }
  .program {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    gap: 44px;
    align-items: center;
  }
  .program--flip .program__photo { order: 2; }
  .program__photo { aspect-ratio: 4 / 3; overflow: hidden; background: var(--rule); }
  .program__photo img { width: 100%; height: 100%; object-fit: cover; }
  .program h3 { font-size: clamp(25px, 2.6vw, 32px); }
  .program p { margin-top: 14px; }
  @media (max-width: 900px) {
    .programs { gap: 44px; }
    .program { grid-template-columns: minmax(0, 1fr); gap: 20px; }
    .program--flip .program__photo { order: 0; }
  }

  /* Recruiting */
  .recruit__intro { margin-top: 16px; max-width: 60ch; }
  .timeline {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 24px;
    margin: 44px 0 0;
    padding: 0;
    list-style: none;
  }
  .step {
    position: relative;
    padding-top: 26px;
    border-top: 2px solid var(--blue);
  }
  .step::before {
    content: '';
    position: absolute;
    top: -8px;
    left: 0;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: var(--blue);
  }
  .step__num {
    display: block;
    font-family: var(--serif);
    font-size: 44px;
    line-height: 1;
    color: var(--blue);
  }
  .step h3 { margin-top: 14px; font-size: 21px; }
  .step p { margin-top: 10px; font-size: 14.5px; }
  @media (max-width: 1000px) {
    .timeline { grid-template-columns: repeat(2, minmax(0, 1fr)); row-gap: 40px; }
  }
  @media (max-width: 600px) {
    .timeline { grid-template-columns: minmax(0, 1fr); row-gap: 32px; }
  }
</style>
